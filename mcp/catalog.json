{
  "description": "MyMilo \u2014 the native town-like buddy, resident interface of the agentic OS. This catalog defines the kernel's MCP tool surface (maven transfer #8 \u2014 reviewed as a checklist, not ported). Each tool maps to a MyMilo HTTP endpoint; a future MCP server exposes these shapes.",
  "name": "mymilo",
  "tools": [
    {
      "description": "OpenAI-compatible chat completion, optionally retrieval-augmented.",
      "endpoint": "POST /v1/chat/completions",
      "input_schema": {
        "properties": {
          "messages": {
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "model": {
            "type": "string"
          },
          "rag": {
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "top_k": {
                "type": "integer"
              }
            },
            "type": "object"
          }
        },
        "required": [
          "model",
          "messages"
        ],
        "type": "object"
      },
      "name": "chat"
    },
    {
      "description": "Cosine-similarity search over indexed documents.",
      "endpoint": "POST /v1/retrieve",
      "input_schema": {
        "properties": {
          "query": {
            "type": "string"
          },
          "top_k": {
            "default": 5,
            "type": "integer"
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      },
      "name": "retrieve"
    },
    {
      "description": "Ingest a file (multipart) into the document index.",
      "endpoint": "POST /v1/documents",
      "input_schema": {
        "properties": {
          "file": {
            "description": "binary upload",
            "type": "string"
          },
          "tags": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "file"
        ],
        "type": "object"
      },
      "name": "documents_upload"
    },
    {
      "description": "List indexed documents.",
      "endpoint": "GET /v1/documents",
      "input_schema": {
        "properties": {},
        "type": "object"
      },
      "name": "documents_list"
    },
    {
      "description": "Delete a document and its chunks.",
      "endpoint": "DELETE /v1/documents/{doc_id}",
      "input_schema": {
        "properties": {
          "doc_id": {
            "type": "string"
          }
        },
        "required": [
          "doc_id"
        ],
        "type": "object"
      },
      "name": "documents_delete"
    },
    {
      "description": "Define a routine. Payload types: briefing {query, top_k, model}, reminder {text}.",
      "endpoint": "POST /v1/jobs",
      "input_schema": {
        "properties": {
          "cron": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "payload": {
            "type": "object"
          }
        },
        "required": [
          "name",
          "payload"
        ],
        "type": "object"
      },
      "name": "jobs_create"
    },
    {
      "description": "List routine definitions.",
      "endpoint": "GET /v1/jobs",
      "input_schema": {
        "properties": {},
        "type": "object"
      },
      "name": "jobs_list"
    },
    {
      "description": "Run a routine immediately (manual trigger).",
      "endpoint": "POST /v1/jobs/{job_id}/trigger",
      "input_schema": {
        "properties": {
          "job_id": {
            "type": "string"
          }
        },
        "required": [
          "job_id"
        ],
        "type": "object"
      },
      "name": "jobs_trigger"
    },
    {
      "description": "Run history for a routine.",
      "endpoint": "GET /v1/jobs/{job_id}/runs",
      "input_schema": {
        "properties": {
          "job_id": {
            "type": "string"
          }
        },
        "required": [
          "job_id"
        ],
        "type": "object"
      },
      "name": "jobs_runs"
    },
    {
      "description": "The planner's outbox: briefings, reminders, notes, quota flags.",
      "endpoint": "GET /v1/suggestions",
      "input_schema": {
        "properties": {},
        "type": "object"
      },
      "name": "suggestions_list"
    },
    {
      "description": "Dismiss a suggestion.",
      "endpoint": "POST /v1/suggestions/{suggestion_id}/dismiss",
      "input_schema": {
        "properties": {
          "suggestion_id": {
            "type": "integer"
          }
        },
        "required": [
          "suggestion_id"
        ],
        "type": "object"
      },
      "name": "suggestions_dismiss"
    },
    {
      "description": "Consent-gated action registry: name, risk, confirmation requirement.",
      "endpoint": "GET /v1/actions",
      "input_schema": {
        "properties": {},
        "type": "object"
      },
      "name": "actions_list"
    },
    {
      "description": "Grant confirm-once consent for an action.",
      "endpoint": "POST /v1/consents",
      "input_schema": {
        "properties": {
          "action": {
            "type": "string"
          }
        },
        "required": [
          "action"
        ],
        "type": "object"
      },
      "name": "consents_grant"
    },
    {
      "description": "Revoke consent for an action.",
      "endpoint": "DELETE /v1/consents/{action_name}",
      "input_schema": {
        "properties": {
          "action_name": {
            "type": "string"
          }
        },
        "required": [
          "action_name"
        ],
        "type": "object"
      },
      "name": "consents_revoke"
    },
    {
      "description": "Per-route monthly cost rollup with free-quota percentages.",
      "endpoint": "GET /v1/ledger/summary",
      "input_schema": {
        "properties": {
          "month": {
            "description": "YYYY-MM",
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "ledger_summary"
    },
    {
      "description": "Model routes with cost metadata, live spend, cheapest-first ranking.",
      "endpoint": "GET /v1/routes",
      "input_schema": {
        "properties": {},
        "type": "object"
      },
      "name": "routes_list"
    },
    {
      "description": "Installed drop-a-file skills.",
      "endpoint": "GET /v1/skills",
      "input_schema": {
        "properties": {},
        "type": "object"
      },
      "name": "skills_list"
    },
    {
      "description": "Re-scan the skills directory for added/changed/removed skills.",
      "endpoint": "POST /v1/skills/rescan",
      "input_schema": {
        "properties": {},
        "type": "object"
      },
      "name": "skills_rescan"
    },
    {
      "description": "The resident's configured persona (name, system prompt).",
      "endpoint": "GET /v1/persona",
      "input_schema": {
        "properties": {},
        "type": "object"
      },
      "name": "persona_get"
    },
    {
      "name": "memory_get_profile",
      "description": "Get the user's semantic profile: durable facts grouped by category (personal, preferences, etc.).",
      "endpoint": "GET /v1/profile",
      "input_schema": {
        "type": "object",
        "properties": {
          "user_email": {
            "type": "string",
            "description": "User's email (defaults to caller)"
          }
        },
        "required": []
      }
    },
    {
      "name": "memory_search_facts",
      "description": "Search the user's semantic facts by keyword.",
      "endpoint": "internal",
      "input_schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Keyword to search facts"
          },
          "user_email": {
            "type": "string",
            "description": "User's email (defaults to caller)"
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "memory_add_fact",
      "description": "Store a durable fact about the user (e.g. preference, personal detail).",
      "endpoint": "internal",
      "input_schema": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "description": "Fact category (personal, preference, project, etc.)"
          },
          "key": {
            "type": "string",
            "description": "Fact key"
          },
          "value": {
            "type": "string",
            "description": "Fact value"
          },
          "user_email": {
            "type": "string",
            "description": "User's email (defaults to caller)"
          }
        },
        "required": [
          "category",
          "key",
          "value"
        ]
      }
    },
    {
      "name": "memory_delete_fact",
      "description": "Delete a user fact by ID (user request).",
      "endpoint": "DELETE /v1/profile/facts/{fact_id}",
      "input_schema": {
        "type": "object",
        "properties": {
          "fact_id": {
            "type": "string",
            "description": "Fact ID (category:key)"
          },
          "user_email": {
            "type": "string",
            "description": "User's email (defaults to caller)"
          }
        },
        "required": [
          "fact_id"
        ]
      }
    },
    {
      "name": "escalation_result",
      "description": "Poll for the result of a previously submitted escalation. Returns the result when Wright has processed it, or pending status.",
      "endpoint": "internal",
      "input_schema": {
        "type": "object",
        "properties": {
          "escalation_id": {
            "type": "string",
            "description": "Escalation ID from the escalate call"
          }
        },
        "required": [
          "escalation_id"
        ]
      }
    }
  ],
  "version": "0.5.0"
}